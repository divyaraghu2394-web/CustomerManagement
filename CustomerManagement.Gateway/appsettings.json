{
  "ReverseProxy": {
    "Routes": {
      "customer-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/customers/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/customers"
          }
        ]
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/orders/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/orders"
          }
        ]
      }
    },
    "Clusters": {
      "customer-cluster": {
        "Destinations": {
          "customer-api": {
            "Address": "https+http://customermanagement-api/"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order-api": {
            "Address": "https+http://ordermanagement-api/"
          }
        }
      }
    }
  }
}
